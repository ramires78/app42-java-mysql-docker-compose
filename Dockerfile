# Этап 1. Собираем наше Java-приложение

# Берем готовый образ, где уже есть Maven 3.9.9 и Java 8.
# builder — просто название этого этапа, потом по нему заберем готовый WAR.
FROM maven:3.9.9-eclipse-temurin-8 AS builder

# Создаем папку /app внутри контейнера и дальше работаем в ней.
WORKDIR /app

# Закидываем сюда pom.xml, чтобы Maven знал, как собирать приложение и что скачивать.
# Точка в конце — это текущая папка /app.
COPY pom.xml .

# Копируем исходники Java в папку /app/src.
COPY src ./src

# Сюда же копируем страницы, настройки и остальные файлы нашего веб-приложения.
COPY WebContent ./WebContent

# Запускаем Maven. Он почистит старую сборку, скомпилирует Java
# и соберет ROOT.war. Тесты пока запускать не будем.
RUN mvn clean package -DskipTests


# Этап 2. Запускаем наше приложение через Tomcat

# Берем готовый Tomcat 9 с Java 8.
# Maven тут уже не нужен — приложение мы собрали на первом этапе.
# Tomcat 9 подходит нам, потому что приложение использует старый javax.servlet.
FROM tomcat:9.0-jre8-temurin

# Убираем из Tomcat стандартные приложения, которые нам не нужны.
# Это все происходит внутри Docker-образа, на сервере ничего не удаляем.
RUN rm -rf /usr/local/tomcat/webapps/*

# Забираем ROOT.war из первого этапа и кладем его в папку Tomcat.
# Tomcat сам подхватит этот файл и развернет приложение.
# Назвали ROOT, чтобы сайт открывался сразу по IP и порту 8080.
COPY --from=builder /app/target/ROOT.war /usr/local/tomcat/webapps/ROOT.war

# Указываем, что Tomcat работает на порту 8080.
# Сам порт наружу эта команда не открывает, потом сделаем это в Compose.
EXPOSE 8080

# При запуске контейнера стартует Tomcat.
# Он будет работать как основной процесс, пока не остановим контейнер.
CMD ["catalina.sh", "run"]
